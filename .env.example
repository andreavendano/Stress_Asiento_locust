# Copiar a .env (no versionado) y completar.
# Las variables del sistema o del CI tienen prioridad sobre este archivo.

# Clave de los usuarios de performance de QA (se usa cuando la columna "clave" de users.csv viene vacía).
HOLISTOR_QA_CLAVE=

# Sobrescribir cualquier valor de environments/<amb>.yaml: HOLISTOR__<seccion>__<clave>=valor
# Ejemplos:
# HOLISTOR__FLUJO__POLLING__INTERVALO_S=2
# HOLISTOR__WAIT_TIME__MIN_S=1

# Carpeta raíz del proyecto (opcional; por defecto se busca la carpeta que contiene environments/).
# HOLISTOR_STRESS_ROOT=

# Base del tenant para verificar las corridas (autenticación de SQL Server). Ideal: usuario de solo lectura.
HOLISTOR_QA_DB_SERVIDOR=
HOLISTOR_QA_DB_BASE=
HOLISTOR_QA_DB_USUARIO=
HOLISTOR_QA_DB_CLAVE=
